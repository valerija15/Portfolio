---
/** Renders an image or a looping video described by content data. */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { type Lang, l } from '@/i18n';
import LoopVideo from './LoopVideo.astro';

type Loc = { lv: string; en: string };
export type MediaData =
  | { type: 'image'; src: ImageMetadata; alt: Loc }
  | { type: 'video'; src: string; webm?: string; poster: ImageMetadata; alt: Loc };

interface Props {
  lang: Lang;
  media: MediaData;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  standalone?: boolean;
  class?: string;
}
const { lang, media, sizes, widths = [480, 800, 1200, 1600, 2000, 2400], priority = false, standalone = true, class: className } = Astro.props;
const alt = l(media.alt, lang);
---
{media.type === 'image' ? (
  <Picture
    src={media.src}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter((w) => w <= media.src.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    decoding={priority ? 'sync' : 'async'}
    class={className}
  />
) : (
  <LoopVideo lang={lang} src={media.src} webm={media.webm} poster={media.poster} alt={alt} sizes={sizes} widths={widths} priority={priority} standalone={standalone} class={className} />
)}
