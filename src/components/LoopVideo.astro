---
/**
 * Muted, looping, decorative-ish video with an optimized poster underneath.
 * Behaviour (autoplay in view, pause off-screen, reduced motion) lives in scripts/videos.ts.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '@/i18n';
import VideoToggle from './VideoToggle.astro';

interface Props {
  lang: Lang;
  src: string;
  webm?: string;
  poster: ImageMetadata;
  alt: string;
  sizes: string;
  widths?: number[];
  priority?: boolean;
  /** When false, the parent element owns [data-loop-video] and renders its own toggle. */
  standalone?: boolean;
  class?: string;
}
const { lang, src, webm, poster, alt, sizes, widths = [480, 800, 1200, 1600, 2000], priority = false, standalone = true, class: className } = Astro.props;
---
<div class:list={['loop-video', className]} data-loop-video={standalone ? '' : undefined}>
  <Picture
    src={poster}
    alt={alt}
    formats={['avif', 'webp']}
    widths={widths.filter((w) => w <= poster.width)}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : 'auto'}
    class="loop-video__poster"
  />
  <video muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture>
    {webm && <source src={webm} type="video/webm" />}
    <source src={src} type="video/mp4" />
  </video>
  {standalone && <VideoToggle lang={lang} />}
</div>

<style>
  .loop-video { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .loop-video :global(picture), .loop-video :global(img), .loop-video video {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .loop-video video { opacity: 0; transition: opacity 600ms ease; }
  :global(.is-playing) .loop-video video, .loop-video:global(.is-playing) video { opacity: 1; }
</style>
