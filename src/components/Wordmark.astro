---
/** Outlet logo: uses a real logo image when provided, otherwise a typographic wordmark. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { name: string; logo?: ImageMetadata; style?: 'serif' | 'sans' | 'italic' | 'mono' | 'condensed'; class?: string }
const { name, logo, style = 'serif', class: className } = Astro.props;
---
{logo ? (
  <Image src={logo} alt={name} height={40} class:list={['wordmark-img', className]} />
) : (
  <span class:list={['wordmark', `wordmark--${style}`, className]}>{name}</span>
)}
<style>
  .wordmark { display: inline-block; line-height: 1; white-space: nowrap; }
  .wordmark--serif { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; }
  .wordmark--italic { font-family: var(--font-display); font-style: italic; font-weight: 450; }
  .wordmark--sans { font-family: var(--font-body); font-weight: 800; letter-spacing: -0.03em; }
  .wordmark--mono { font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace; font-weight: 500; letter-spacing: 0.02em; text-transform: lowercase; }
  .wordmark--condensed { font-family: var(--font-body); font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; font-stretch: condensed; font-size: 0.82em; }
  .wordmark-img { height: 2.5rem; width: auto; }
</style>
