---
import { type Lang, useTranslations } from '@/i18n';
interface Props { lang: Lang }
const t = useTranslations(Astro.props.lang);
---
<button type="button" class="video-toggle" data-video-toggle aria-pressed="true" aria-label={t('common.playVideo')} data-label-play={t('common.playVideo')} data-label-pause={t('common.pauseVideo')}>
  <svg class="video-toggle__play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>
  <svg class="video-toggle__pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor" /></svg>
</button>

<style>
  .video-toggle {
    position: absolute; right: 0.75rem; bottom: 0.75rem; z-index: 3;
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem;
    background: rgb(20 20 19 / 0.72); color: var(--color-paper);
    border-radius: 50%;
    transition: background var(--dur-fast);
  }
  .video-toggle:hover { background: var(--color-ink); }
  .video-toggle__pause { display: none; }
  :global(.is-playing) > .video-toggle .video-toggle__pause,
  :global(.is-playing) .video-toggle .video-toggle__pause { display: block; }
  :global(.is-playing) > .video-toggle .video-toggle__play,
  :global(.is-playing) .video-toggle .video-toggle__play { display: none; }
  :global(html:not(.js)) .video-toggle { display: none; }
</style>
