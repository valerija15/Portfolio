---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import { type Lang, langPaths, useTranslations } from '@/i18n';
import { md } from '@/lib/markdown';
import { getSite } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const site = await getSite();
---
<BaseLayout lang={lang} title={t('meta.privacy.title')} description={t('meta.privacy.description')}>
  <PageHeader title={t('privacy.title')} />
  <section class="container privacy">
    <div class="prose" set:html={md(t('privacy.body', { email: site.email }))} />
  </section>
</BaseLayout>
<style>
  .privacy { padding-bottom: var(--space-2xl); }
  .privacy .prose { max-width: 42rem; margin-left: auto; margin-right: max(0px, calc((100% - 42rem) / 3)); }
  .privacy .prose :global(h2) { font-size: var(--step-2); margin-top: var(--space-l); padding-top: var(--space-s); border-top: 1px solid var(--color-line); }
</style>
