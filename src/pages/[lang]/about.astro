---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ContactBand from '@/components/ContactBand.astro';
import { type Lang, langPaths, useTranslations, l } from '@/i18n';
import { routeUrl } from '@/lib/routes';
import { md } from '@/lib/markdown';
import { pad2 } from '@/lib/format';
import { getSite } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const site = await getSite();
const a = site.about;
---
<BaseLayout lang={lang} title={t('meta.about.title')} description={t('meta.about.description')} type="profile">
  <PageHeader eyebrow={`${site.name} — ${l(site.title, lang)}`} title={t('about.title')} />

  <section class="container about-intro" aria-label={t('about.title')}>
    <figure class="about-intro__portrait frame" data-reveal="mask">
      <Picture src={a.portrait} alt={l(a.portraitAlt, lang)} formats={['avif', 'webp']} widths={[480, 800, 1100, 1500]} sizes="(min-width: 64rem) 40vw, 100vw" loading="eager" fetchpriority="high" />
    </figure>
    <div class="about-intro__text">
      <p class="lead about-intro__lead" data-reveal>{l(a.lead, lang)}</p>
      <div class="prose measure" data-reveal style="--reveal-delay:1" set:html={md(l(a.bio, lang))} />
      <div class="about-intro__actions" data-reveal style="--reveal-delay:2">
        {site.cvPath && (
          <a class="btn btn--ghost" href={site.cvPath} download type="application/pdf">
            {t('about.cv')}
            <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false"><path d="M8 2v9m-4-4 4 4 4-4M3 14h10" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
          </a>
        )}
        <a class="link" href={routeUrl(lang, 'experience')}>{t('nav.experience')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="principles-title">
    <div class="section-head" data-reveal><h2 id="principles-title">{t('about.principles')}</h2></div>
    <ol role="list" class="principles">
      {a.principles.map((p, i) => (
        <li data-reveal style={`--reveal-delay:${i % 2}`}>
          <span class="principles__num index-num" aria-hidden="true">{pad2(i + 1)}</span>
          <h3>{l(p.title, lang)}</h3>
          <p>{l(p.text, lang)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section container expertise" aria-labelledby="expertise-title">
    <div class="section-head" data-reveal><h2 id="expertise-title">{t('about.expertise')}</h2></div>
    <ul role="list" class="expertise__list">
      {a.expertise.map((e, i) => <li data-reveal style={`--reveal-delay:${i % 4}`}>{l(e, lang)}</li>)}
    </ul>
  </section>

  <ContactBand lang={lang} email={site.email} />
</BaseLayout>

<style>
  .about-intro { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-xl) var(--gutter); padding-bottom: var(--space-xl); }
  .about-intro__portrait { grid-column: 1 / -1; aspect-ratio: 3 / 4; }
  .about-intro__text { grid-column: 1 / -1; display: grid; gap: var(--space-l); align-content: start; }
  .about-intro__lead { font-size: var(--step-3); line-height: 1.2; }
  .about-intro__actions { display: flex; flex-wrap: wrap; gap: var(--space-m) var(--space-l); align-items: center; }
  @media (max-width: 47.99rem) { .about-intro__portrait { grid-column: 2 / -1; } }
  @media (min-width: 64rem) {
    .about-intro__portrait { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h-compact) + 1.5rem); align-self: start; }
    .about-intro__text { grid-column: 7 / -1; padding-top: var(--space-xl); }
  }
  .principles { display: grid; gap: var(--space-xl) var(--gutter); }
  @media (min-width: 48rem) { .principles { grid-template-columns: repeat(2, 1fr); } .principles li:nth-child(even) { margin-top: var(--space-xl); } }
  .principles li { display: grid; gap: var(--space-xs); padding-top: var(--space-s); border-top: 1px solid var(--color-ink); }
  .principles__num { color: var(--color-accent); font-size: var(--step--1); }
  .principles h3 { font-size: var(--step-3); }
  .principles p { max-width: 36ch; color: var(--color-charcoal); }
  .expertise__list { display: flex; flex-wrap: wrap; gap: 0 var(--space-m); font-family: var(--font-display); font-size: var(--step-4); line-height: 1.25; font-weight: 340; letter-spacing: -0.02em; }
  .expertise__list li:not(:last-child)::after { content: ' /'; color: var(--color-accent); font-style: italic; }
</style>
