---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import MediaBlock from '@/components/MediaBlock.astro';
import ContactBand from '@/components/ContactBand.astro';
import Wordmark from '@/components/Wordmark.astro';
import { type Lang, langPaths, useTranslations, l } from '@/i18n';
import { routeUrl } from '@/lib/routes';
import { getSite, getProjects, getPublications, getTestimonials } from '@/lib/content';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const site = await getSite();
const featured = (await getProjects()).filter((p) => p.featured).slice(0, 6);
const publications = await getPublications();
const outlets = [...new Map(publications.filter((p) => p.highlight).map((p) => [p.outlet.name, p.outlet])).values()];
const testimonials = (await getTestimonials()).slice(0, 3);
const [line1, line2] = site.hero.headline[lang];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: l(site.title, lang),
  email: `mailto:${site.email}`,
  url: new URL(`/${lang}/`, Astro.site).href,
  image: new URL(site.ogImage, Astro.site).href,
  sameAs: [site.socials.linkedin],
  address: { '@type': 'PostalAddress', addressLocality: lang === 'lv' ? 'Rīga' : 'Riga', addressCountry: 'LV' },
  knowsAbout: site.about.expertise.map((e) => l(e, lang)),
};
---
<BaseLayout lang={lang} title={t('meta.home.title')} description={t('meta.home.description')} type="profile" jsonLd={jsonLd}>
  <section class="hero container" aria-labelledby="hero-title">
    <div class="hero__text">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__name eyebrow">{site.name} <span aria-hidden="true">—</span><span class="sr-only">,</span> {l(site.title, lang)}</span>
        <span class="hero__line display">{line1}</span>
        <span class="hero__line hero__line--2 display">{line2}</span>
      </h1>
      <p class="hero__intro">{l(site.hero.intro, lang)}</p>
      <div class="hero__ctas">
        <a class="btn" href={routeUrl(lang, 'work')}>{t('home.ctaWork')} <span class="arrow" aria-hidden="true">→</span></a>
        <a class="link" href={routeUrl(lang, 'contact')}>{t('home.ctaContact')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
    <figure class="hero__media">
      <div class="frame hero__frame" data-reveal="mask">
        <MediaBlock lang={lang} media={site.hero.media} sizes="(min-width: 64rem) 40vw, 82vw" widths={[480, 640, 800, 1100, 1400]} priority />
      </div>
      {site.hero.caption && <figcaption class="eyebrow">{l(site.hero.caption, lang)}</figcaption>}
    </figure>
    <a class="hero__scroll" href="#selected-work">
      <span class="hero__scroll-line" aria-hidden="true"></span>
      <span>{t('home.scroll')}</span>
    </a>
  </section>

  <section class="section container" id="selected-work" aria-labelledby="selected-work-title">
    <div class="section-head" data-reveal>
      <h2 id="selected-work-title"><span class="eyebrow index-num">(01)</span> {t('home.selectedWork')}</h2>
      <a class="link" href={routeUrl(lang, 'work')}>{t('home.allWork')} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
    <ProjectGrid lang={lang} projects={featured} />
  </section>

  <section class="section about-teaser container" aria-labelledby="about-teaser-title">
    <div class="section-head" data-reveal>
      <h2 id="about-teaser-title"><span class="eyebrow index-num">(02)</span> {t('home.aboutTitle')}</h2>
    </div>
    <div class="about-teaser__grid">
      <div class="frame about-teaser__img" data-reveal="mask">
        <Picture src={site.about.teaserPortrait} alt={l(site.about.teaserPortraitAlt, lang)} formats={['avif', 'webp']} widths={[400, 700, 1000, 1400]} sizes="(min-width: 64rem) 34vw, 70vw" loading="lazy" />
      </div>
      <div class="about-teaser__text">
        <p class="lead" data-reveal>{l(site.about.lead, lang)}</p>
        <p class="measure" data-reveal style="--reveal-delay:1">{l(site.about.teaser, lang)}</p>
        <a class="link" href={routeUrl(lang, 'about')} data-reveal style="--reveal-delay:2">{t('home.aboutLink')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  {outlets.length > 0 && (
    <section class="media-strip" aria-labelledby="media-strip-title">
      <div class="container media-strip__inner">
        <h2 id="media-strip-title" class="eyebrow">{t('home.mediaTitle')}</h2>
        <ul role="list" class="media-strip__list">
          {outlets.map((o) => <li><Wordmark name={o.name} logo={o.logo} style={o.wordmark} /></li>)}
        </ul>
        <a class="link media-strip__more" href={routeUrl(lang, 'media')}>{t('nav.media')} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="section container" aria-labelledby="testimonials-title">
      <div class="section-head" data-reveal>
        <h2 id="testimonials-title"><span class="eyebrow index-num">(03)</span> {t('home.testimonialsTitle')}</h2>
      </div>
      <ul role="list" class="quotes">
        {testimonials.map((q, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <figure>
              <blockquote><p>{l(q.quote, lang)}</p></blockquote>
              <figcaption>
                <span class="quotes__name">{q.name}</span>
                <span>{l(q.role, lang)}, {q.organisation}</span>
                {q.fictional && <span class="quotes__flag">{t('common.fictional')}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <ContactBand lang={lang} email={site.email} />
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter);
    padding-top: var(--space-l); padding-bottom: var(--space-2xl);
    min-height: calc(100svh - var(--header-h));
  }
  .hero__text { grid-column: 1 / -1; align-self: center; position: relative; z-index: 2; }
  .hero__title { font: inherit; display: grid; gap: var(--space-s); }
  .hero__name { margin-bottom: var(--space-xs); }
  .hero__line { display: block; font-size: var(--step-5); max-width: 14ch; }
  .hero__line--2 { font-style: italic; color: var(--color-accent); padding-left: 1.2em; }
  .hero__intro { margin-top: var(--space-l); max-width: 34ch; font-size: var(--step-1); line-height: 1.5; }
  .hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m) var(--space-l); margin-top: var(--space-l); }
  .hero__media { grid-column: 4 / -1; grid-row: 1; margin-top: var(--space-m); }
  .hero__frame { aspect-ratio: 4 / 5; }
  .hero__media figcaption { margin-top: 0.6rem; text-align: right; }
  .hero__scroll { display: none; }

  @media (max-width: 63.99rem) {
    .hero { min-height: 0; row-gap: var(--space-l); }
    .hero__text { grid-row: 1; }
    .hero__media { grid-row: 2; margin-top: 0; }
  }
  @media (min-width: 64rem) {
    .hero__text { grid-column: 1 / span 7; grid-row: 1; padding-bottom: var(--space-xl); }
    .hero__media { grid-column: 8 / -1; grid-row: 1; align-self: start; }
    .hero__frame { max-height: calc(100svh - var(--header-h) - 6rem); aspect-ratio: 4 / 5; margin-left: auto; }
    .hero__line { font-size: min(var(--step-6), 6.4vw); }
    .hero__line--2 { padding-left: 0.8em; }
    .hero__scroll {
      display: inline-flex; align-items: center; gap: 0.9rem;
      position: absolute; left: var(--gutter); bottom: var(--space-l);
      font-size: 0.72rem; letter-spacing: var(--tracking-caps); text-transform: uppercase; text-decoration: none; color: var(--color-muted);
    }
    .hero__scroll-line { position: relative; width: 1px; height: 3.5rem; background: var(--color-line-strong); overflow: hidden; }
    .hero__scroll-line::after { content: ''; position: absolute; left: 0; top: 0; width: 1px; height: 40%; background: var(--color-ink); }
  }
  @media (min-width: 64rem) and (prefers-reduced-motion: no-preference) {
    .hero__scroll-line::after { animation: scroll-cue 2.4s var(--ease-in-out) infinite; }
  }
  @keyframes scroll-cue { 0% { transform: translateY(-100%); } 60%, 100% { transform: translateY(260%); } }

  .about-teaser__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--space-l) var(--gutter); align-items: end; }
  .about-teaser__img { grid-column: 1 / span 9; aspect-ratio: 1; }
  .about-teaser__text { grid-column: 1 / -1; display: grid; gap: var(--space-m); justify-items: start; }
  @media (min-width: 48rem) {
    .about-teaser__img { grid-column: 1 / span 5; }
    .about-teaser__text { grid-column: 7 / -1; padding-bottom: var(--space-l); }
  }

  .media-strip { border-block: 1px solid var(--color-line-strong); padding-block: var(--space-l); }
  .media-strip__inner { display: grid; gap: var(--space-m); align-items: center; }
  .media-strip__list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-m) var(--space-l); font-size: var(--step-2); color: var(--color-charcoal); }
  @media (min-width: 64rem) {
    .media-strip__inner { grid-template-columns: 10rem 1fr auto; }
    .media-strip__list { justify-content: space-around; }
  }

  .quotes { display: grid; gap: var(--space-xl) var(--gutter); }
  @media (min-width: 64rem) { .quotes { grid-template-columns: repeat(3, 1fr); } .quotes li:nth-child(2) { margin-top: var(--space-xl); } }
  .quotes blockquote { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; font-weight: 360; }
  .quotes blockquote p::before { content: '“'; display: block; font-size: 3em; line-height: 0.6; color: var(--color-accent); margin-bottom: 0.1em; }
  .quotes figcaption { display: grid; gap: 0.15rem; margin-top: var(--space-m); padding-top: var(--space-s); border-top: 1px solid var(--color-line); font-size: var(--step--1); color: var(--color-muted); }
  .quotes__name { color: var(--color-ink); font-weight: 600; }
  .quotes__flag { font-style: italic; }
</style>
