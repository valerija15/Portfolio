---
/**
 * Bilingual 404 (static hosts serve /404.html for every unknown URL).
 * Latvian and English side by side; links point into each locale.
 */
import '@/styles/global.css';
import lv from '@/i18n/lv.json';
import en from '@/i18n/en.json';
import { withBase } from '@/lib/url';
import newsreaderUrl from '@/assets/fonts/newsreader-latin-opsz-normal.woff2?url';
const texts = [
  { lang: 'lv', d: lv },
  { lang: 'en', d: en },
] as const;
---
<!doctype html>
<html lang="lv">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#f4f2ec" />
    <title>404 — {lv.meta.notFound.title} / {en.meta.notFound.title}</title>
    <meta name="description" content={`${lv.meta.notFound.description} ${en.meta.notFound.description}`} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={newsreaderUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <main class="nf container" id="main">
      <p class="nf__code display" aria-hidden="true">404</p>
      <div class="nf__cols">
        {texts.map(({ lang, d }) => (
          <section lang={lang} aria-labelledby={`nf-${lang}`}>
            <p class="eyebrow eyebrow--accent">{lang.toUpperCase()}</p>
            <h1 id={`nf-${lang}`} class="display nf__title">{d.notFound.title}</h1>
            <p>{d.notFound.text}</p>
            <ul role="list" class="nf__links">
              <li><a class="link" href={withBase(`/${lang}/`)}>{d.notFound.home} <span class="arrow" aria-hidden="true">→</span></a></li>
              <li><a class="link" href={withBase(`/${lang}/work/`)}>{d.notFound.work} <span class="arrow" aria-hidden="true">→</span></a></li>
            </ul>
          </section>
        ))}
      </div>
    </main>
    <style>
      .nf { min-height: 100svh; display: grid; align-content: center; gap: var(--space-l); padding-block: var(--space-xl); }
      .nf__code { font-size: clamp(6rem, 30vw, 20rem); line-height: 0.8; color: var(--color-accent); font-style: italic; }
      .nf__cols { display: grid; gap: var(--space-xl) var(--gutter); border-top: 1px solid var(--color-line-strong); padding-top: var(--space-l); }
      @media (min-width: 48rem) { .nf__cols { grid-template-columns: 1fr 1fr; } }
      .nf__cols section { display: grid; gap: var(--space-s); align-content: start; }
      .nf__title { font-size: var(--step-4); max-width: 14ch; }
      .nf__links { display: flex; flex-wrap: wrap; gap: var(--space-m); margin-top: var(--space-s); }
    </style>
  </body>
</html>
